@model IEnumerable<KutuphaneYonetimSistemi.Models.Author>

@{
    ViewData["Title"] = "Yazarlar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fa-solid fa-user-pen me-2"></i> Yazarlar</h2>
    <a asp-action="Create" class="btn btn-success"><i class="fa-solid fa-plus me-1"></i> Yeni Yazar Ekle</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.AuthorName)</th>
                    <th>@Html.DisplayNameFor(model => model.AuthorSurname)</th>
                    <th>@Html.DisplayNameFor(model => model.BirthDate)</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if(!Model.Any()) {
                    <tr><td colspan="4" class="text-center text-muted py-4">Kayıtlı yazar bulunmamaktadır.</td></tr>
                }
                @foreach (var item in Model) {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.AuthorName)</td>
                        <td>@Html.DisplayFor(modelItem => item.AuthorSurname)</td>
                        <td>@item.BirthDate.ToShortDateString()</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.AuthorId" class="btn btn-sm btn-warning"><i class="fa-solid fa-pen-to-square"></i> Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@item.AuthorId" class="btn btn-sm btn-danger"><i class="fa-solid fa-trash"></i> Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
