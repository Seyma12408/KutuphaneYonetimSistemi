@model IEnumerable<KutuphaneYonetimSistemi.Models.Category>

@{
    ViewData["Title"] = "Kategoriler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fa-solid fa-tags me-2"></i> Kategoriler</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Yeni Kategori Ekle</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.CategoryName)</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if(!Model.Any()) {
                    <tr><td colspan="2" class="text-center text-muted py-4">Kayıtlı kategori bulunmamaktadır.</td></tr>
                }
                @foreach (var item in Model) {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.CategoryName)</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-sm btn-warning"><i class="fa-solid fa-pen-to-square"></i> Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-sm btn-danger"><i class="fa-solid fa-trash"></i> Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
