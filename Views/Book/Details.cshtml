@model KutuphaneYonetimSistemi.Models.Book

@{
    ViewData["Title"] = "Kitap Detayları";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card mt-4 shadow-sm border-info">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0"><i class="fa-solid fa-circle-info me-2"></i> Kitap Detayları</h4>
            </div>
            <div class="card-body">
                <div class="text-center mb-4">
                    <i class="fa-solid fa-book-open-reader fa-4x text-muted mb-3"></i>
                    <h2 class="fw-bold">@Model.BookName</h2>
                </div>

                <div class="row bg-light p-3 rounded">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item bg-transparent border-0 d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="fa-solid fa-user-pen me-2"></i> Yazar:</span>
                                <span class="fw-bold">@Model.Author.AuthorName @Model.Author.AuthorSurname</span>
                            </li>
                            <li class="list-group-item bg-transparent border-0 d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="fa-solid fa-tags me-2"></i> Kategori:</span>
                                <span class="badge bg-secondary">@Model.Category.CategoryName</span>
                            </li>
                            <li class="list-group-item bg-transparent border-0 d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="fa-solid fa-calendar-days me-2"></i> Yayın Yılı:</span>
                                <span class="fw-bold">@Model.PublishYear</span>
                            </li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item bg-transparent border-0 d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="fa-solid fa-file-lines me-2"></i> Sayfa Sayısı:</span>
                                <span class="fw-bold">@Model.PageCount</span>
                            </li>
                            <li class="list-group-item bg-transparent border-0 d-flex justify-content-between align-items-center">
                                <span class="text-muted"><i class="fa-solid fa-cubes me-2"></i> Stok Durumu:</span>
                                @if (Model.Stock > 0)
                                {
                                    <span class="badge bg-success rounded-pill px-3">@Model.Stock Adet Mevcut</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger rounded-pill px-3">Tükendi</span>
                                }
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-secondary"><i class="fa-solid fa-arrow-left me-1"></i> Listeye Dön</a>
                    <div>
                        <a asp-action="Edit" asp-route-id="@Model?.BookId" class="btn btn-warning"><i class="fa-solid fa-pen-to-square me-1"></i> Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@Model?.BookId" class="btn btn-danger"><i class="fa-solid fa-trash me-1"></i> Sil</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
