@{
    ViewData["Title"] = "Dashboard";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold"><i class="fa-solid fa-chart-pie me-2"></i> Yönetim Paneli</h2>
        <p class="text-muted">Kütüphane sisteminin genel özetini buradan takip edebilirsiniz.</p>
    </div>
</div>

<div class="row">
    <!-- Kitaplar Kartı -->
    <div class="col-md-4 mb-4">
        <div class="card bg-primary text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-uppercase fw-bold opacity-75">Toplam Kitap</h6>
                        <h2 class="display-5 fw-bold mb-0">@ViewBag.TotalBooks</h2>
                    </div>
                    <i class="fa-solid fa-book fa-3x opacity-50"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-controller="Book" asp-action="Index" class="text-white text-decoration-none d-flex justify-content-between align-items-center">
                    <span>Detayları Gör</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Yazarlar Kartı -->
    <div class="col-md-4 mb-4">
        <div class="card bg-success text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-uppercase fw-bold opacity-75">Kayıtlı Yazar</h6>
                        <h2 class="display-5 fw-bold mb-0">@ViewBag.TotalAuthors</h2>
                    </div>
                    <i class="fa-solid fa-user-pen fa-3x opacity-50"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-controller="Author" asp-action="Index" class="text-white text-decoration-none d-flex justify-content-between align-items-center">
                    <span>Detayları Gör</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Kategoriler Kartı -->
    <div class="col-md-4 mb-4">
        <div class="card bg-warning text-dark h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-uppercase fw-bold opacity-75">Kategori Sayısı</h6>
                        <h2 class="display-5 fw-bold mb-0">@ViewBag.TotalCategories</h2>
                    </div>
                    <i class="fa-solid fa-tags fa-3x opacity-50"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 border-dark">
                <a asp-controller="Category" asp-action="Index" class="text-dark text-decoration-none d-flex justify-content-between align-items-center">
                    <span>Detayları Gör</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>
